{
  "name": "rti-sarathi",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Phase 2.5 deterministic reasoning prototype. No dependencies, no network, no LLM.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\" && vitest run",
    "test:reasoning": "node --test \"test/*.test.js\"",
    "test:unit": "vitest run",
    "eval": "node scripts/evaluate.js",
    "eval:holdout": "node scripts/holdout.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}